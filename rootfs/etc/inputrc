# /etc/inputrc - global inputrc for libreadline

set bell-style none
set meta-flag on
set input-meta on
set convert-meta off
set output-meta on

# Keys sent by the IotaOS console
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line
"\e[3~": delete-char
"\e[2~": quoted-insert

# Ctrl-C at the prompt throws the line away
"\C-c": kill-whole-line
